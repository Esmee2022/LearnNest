NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_PEPPER=replace-with-32-or-more-random-bytes
PEPPER_VERSION=v1
# During rotation, configure the previous pepper/version temporarily. Remove only after active accounts rehash.
PREVIOUS_PASSWORD_PEPPER=
PREVIOUS_PEPPER_VERSION=
TOTP_ENCRYPTION_KEY=base64-encoded-32-byte-key
COOKIE_SECURE=false
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
BACKUP_STORAGE_BUCKET=learnnest-backups
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_PARENT_PASSWORD=
SEED_CHILD_PASSWORD=
EXPO_PUBLIC_API_URL=http://localhost:4000/api
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LearnNest <accounts@example.org>
